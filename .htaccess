<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect direct /public URLs to the clean domain-root URL.
    RewriteCond %{THE_REQUEST} \s/+public(?:[/?\s]) [NC]
    RewriteRule ^public/?(.*)$ /$1 [R=301,L,NE]

    # Stop here after the internal rewrite has entered the public directory.
    RewriteRule ^public(?:/|$) - [L]

    # Serve real public assets without exposing repository files.
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.+)$ public/$1 [L]

    # Send application requests straight to Laravel's front controller. This
    # avoids an Apache DirectoryIndex subrequest for the domain root.
    RewriteRule ^ public/index.php [L]
</IfModule>

Options -Indexes
